# Application Settings
APP_NAME=Prompt Ledger
APP_VERSION=0.1.0
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/prompt_ledger

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (only required when provider: "anthropic" is used)
ANTHROPIC_API_KEY=

# Security
# REQUIRED: Change this before production deployment.
# This is the ADMIN / DEFAULT PROJECT key — it:
#   - Authenticates as the "default" project (scopes all data to that project)
#   - Is the only key authorised to call POST/DELETE /v1/admin/* endpoints
# Consuming applications (e.g. SRF) should get their own project-scoped key via:
#   POST /v1/admin/projects  →  returns a one-time plaintext key
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=dev-key-change-in-production

# Celery (auto-configured from Redis URL)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# E2E tests — live Railway deployment
PROMPTLEDGER_URL=https://your-api.up.railway.app
PROMPTLEDGER_API_KEY=your-api-key-here
